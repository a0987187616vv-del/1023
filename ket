import threading
import time
import tkinter as tk
from tkinter import ttk, messagebox

import pyautogui
from pynput import keyboard

# Safety: move mouse to the top-left corner to trigger PyAutoGUI's failsafe.
pyautogui.FAILSAFE = True
pyautogui.PAUSE = 0

class AutoClickerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Anime Zero 自動操作工具")
        self.root.resizable(False, False)

        self.running = threading.Event()
        self.shutdown = threading.Event()
        self.mouse_held = False
        self.lock = threading.Lock()

        self.mode = tk.StringVar(value="click")
        self.cps = tk.StringVar(value="10")
        self.status = tk.StringVar(value="狀態：已停止")
        self.hotkey_text = tk.StringVar(value="快捷鍵：F6 啟動／停止")

        frame = ttk.Frame(root, padding=16)
        frame.grid(row=0, column=0, sticky="nsew")

        ttk.Label(frame, text="Roblox《Anime Zero》自動操作工具",
                  font=("Segoe UI", 12, "bold")).grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 12))

        ttk.Label(frame, text="操作模式：").grid(row=1, column=0, sticky="w", pady=4)
        modes = ttk.Frame(frame)
        modes.grid(row=1, column=1, sticky="w", pady=4)
        ttk.Radiobutton(modes, text="連續點擊", variable=self.mode, value="click",
                        command=self.update_cps_state).grid(row=0, column=0, padx=(0, 8))
        ttk.Radiobutton(modes, text="持續按住左鍵", variable=self.mode, value="hold",
                        command=self.update_cps_state).grid(row=0, column=1)

        ttk.Label(frame, text="點擊速度（CPS）：").grid(row=2, column=0, sticky="w", pady=4)
        self.cps_spin = ttk.Spinbox(frame, from_=0.1, to=100, increment=0.5,
                                    textvariable=self.cps, width=10)
        self.cps_spin.grid(row=2, column=1, sticky="w", pady=4)

        ttk.Label(frame, text="快捷鍵：").grid(row=3, column=0, sticky="w", pady=4)
        ttk.Label(frame, text="F6").grid(row=3, column=1, sticky="w", pady=4)

        buttons = ttk.Frame(frame)
        buttons.grid(row=4, column=0, columnspan=2, sticky="ew", pady=(12, 8))
        self.toggle_button = ttk.Button(buttons, text="啟動（F6）", command=self.toggle)
        self.toggle_button.grid(row=0, column=0, padx=(0, 8))
        ttk.Button(buttons, text="停止", command=self.stop).grid(row=0, column=1, padx=(0, 8))
        ttk.Button(buttons, text="離開", command=self.close).grid(row=0, column=2)

        ttk.Label(frame, textvariable=self.status).grid(row=5, column=0, columnspan=2, sticky="w", pady=(4, 2))
        ttk.Label(frame, textvariable=self.hotkey_text).grid(row=6, column=0, columnspan=2, sticky="w")

        note = ("提示：將遊戲視窗設為前景視窗後再啟動。移動滑鼠到螢幕左上角可觸發安全停止。"
                "\n請確認遊戲規則允許自動輸入；遊戲可能忽略合成的滑鼠事件。")
        ttk.Label(frame, text=note, wraplength=440, foreground="#555").grid(
            row=7, column=0, columnspan=2, sticky="w", pady=(12, 0))

        self.listener = keyboard.Listener(on_press=self.on_key_press)
        self.listener.start()

        self.worker = threading.Thread(target=self.run_loop, daemon=True)
        self.worker.start()

        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.update_cps_state()

    def update_cps_state(self):
        self.cps_spin.configure(state="normal" if self.mode.get() == "click" else "disabled")

    def on_key_press(self, key):
        if key == keyboard.Key.f6:
            # Avoid manipulating Tkinter widgets from the listener thread.
            self.root.after(0, self.toggle)

    def toggle(self):
        if self.running.is_set():
            self.stop()
        else:
            try:
                if self.mode.get() == "click":
                    value = float(self.cps.get())
                    if not 0.1 <= value <= 100:
                        raise ValueError
            except ValueError:
                messagebox.showerror("設定錯誤", "CPS 請輸入 0.1 到 100 之間的數字。")
                return
            self.running.set()
            self.status.set("狀態：運作中")
            self.toggle_button.configure(text="停止（F6）")

    def release_mouse(self):
        with self.lock:
            if self.mouse_held:
                try:
                    pyautogui.mouseUp(button="left")
                except Exception:
                    pass
                self.mouse_held = False

    def stop(self):
        self.running.clear()
        self.release_mouse()
        self.status.set("狀態：已停止")
        self.toggle_button.configure(text="啟動（F6）")

    def run_loop(self):
        while not self.shutdown.is_set():
            if not self.running.is_set():
                time.sleep(0.03)
                continue
            try:
                if self.mode.get() == "hold":
                    if not self.mouse_held:
                        pyautogui.mouseDown(button="left")
                        self.mouse_held = True
                    time.sleep(0.03)
                else:
                    cps_value = max(0.1, min(100.0, float(self.cps.get())))
                    pyautogui.click(button="left")
                    time.sleep(1.0 / cps_value)
            except pyautogui.FailSafeException:
                self.root.after(0, self.stop)
            except Exception as exc:
                self.root.after(0, self.stop)
                self.root.after(0, lambda e=str(exc): messagebox.showerror("操作錯誤", e))
                time.sleep(0.1)

    def close(self):
        self.running.clear()
        self.shutdown.set()
        self.release_mouse()
        try:
            self.listener.stop()
        except Exception:
            pass
        self.root.destroy()

def main():
    root = tk.Tk()
    app = AutoClickerApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()
